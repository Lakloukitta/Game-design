# ─────────────────────────────────────────────────────────────────────────────
# Trip Autopilot — environment variables
# Copy this file to .env.local and fill in the values. NEVER commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Duffel API access token. MUST be a TEST-mode token (starts with
# "duffel_test_"). The app refuses to perform supplier calls with a live token.
# Obtain from https://app.duffel.com → Developers → Access tokens (Test mode).
DUFFEL_ACCESS_TOKEN=

# Supabase project URL. This is the ONLY Supabase value safe to expose to the
# browser. Example: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase server-side privileged key (preferred new "secret key" model).
# NEVER expose to the browser. Do NOT prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Legacy Supabase service-role key. Supported for backward compatibility only.
# Use SUPABASE_SECRET_KEY if you have it. NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Optional ─────────────────────────────────────────────────────────────────

# Server-controlled mock mode. When "true", all supplier calls use deterministic
# local fixtures and no Duffel/Supabase credentials are required. Tests run in
# this mode by default. NEVER trust a browser parameter to enable this.
TRAVEL_APP_MOCK_MODE=false

# Public hint used purely to render the "Local mock inventory" banner in the UI.
# This does NOT control server behaviour; the server flag above is authoritative.
NEXT_PUBLIC_TRAVEL_APP_MOCK_MODE=false

# Duffel webhook signing secret (reserved for future webhook handling).
DUFFEL_WEBHOOK_SECRET=

# Log verbosity: error | warn | info | debug
LOG_LEVEL=info
